# ==============================================================================
# LoanPulse Production Environment Configuration Template
# ==============================================================================
# IMPORTANT:
# - This template contains PLACEHOLDER values only. Never put real credentials here.
# - Do NOT commit production credentials or the active .env file to version control.
# - On platforms like Render, Railway, or AWS, configure these variables in the platform dashboard.
# ==============================================================================

# Application & Environment Mode
FLASK_APP=wsgi.py
FLASK_ENV=production

# Security: Mandatory 32+ byte cryptographic key in production.
# Generate a new random secret with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_cryptographically_secure_random_key_min_32_bytes

# Database Connection: PostgreSQL connection string (production recommendation)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://loanpulse_prod_user:replace_with_strong_db_password@db_host.internal:5432/loanpulse_prod

# Cookie & Session Security
# Must be True when serving over HTTPS behind a TLS-terminating reverse proxy
SESSION_COOKIE_SECURE=True

# Reverse Proxy Integration
# Set to True when running behind Render, Railway, Nginx, Caddy, Cloudflare, or AWS ALB
BEHIND_PROXY=True

# Network & Server Concurrency
PORT=8000
WEB_CONCURRENCY=2
PYTHON_THREADS=2
GUNICORN_TIMEOUT=60
LOG_LEVEL=info

# Persistent Upload Storage Directory (Ensure write permissions for the web user)
UPLOAD_FOLDER=/var/data/loanpulse/uploads/documents
